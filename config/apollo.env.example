# ApolloRE v2 configuration template
# Copy to: ~/.config/apollore/config.env
# Never commit your real secrets.
# Values are parsed literally; shell expressions such as $HOME are NOT expanded.

# General runtime defaults.
# Leave APOLLO_OUTPUT_BASE empty to use ./results from your current directory.
APOLLO_OUTPUT_BASE=""
APOLLO_RATE_LIMIT=50
APOLLO_USER_AGENT="ApolloRE/2.0"
NUCLEI_SEVERITIES="low,medium,high,critical"

# CVE correlation defaults.
# Limits the number of unique technology strings sent to NVD per run.
CVE_MAX_TECH_QUERIES=8

# Optional provider/API configuration.
# ApolloRE exports these for modules/tools that support them.
# Prefer provider-specific config files when the underlying tool supports them.

# ProjectDiscovery Subfinder provider file.
# Set an absolute path, for example: /home/username/.config/subfinder/provider-config.yaml
SUBFINDER_PROVIDER_CONFIG=""

# Optional API credentials.
SHODAN_API_KEY=""
# NVD works without a key but has a lower public rate limit.
NVD_API_KEY=""
WPSCAN_API_TOKEN=""
GITHUB_TOKEN=""
